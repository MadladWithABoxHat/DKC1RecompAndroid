+ *   event   = (kind << 4) | slot    kind: see StateEvent */
+enum { kOpSave = 1, kOpLoad = 2 };
+enum { kEvtSaved = 1, kEvtLoaded = 2, kEvtSaveFailed = 3, kEvtLoadFailed = 4,
+       kEvtNoState = 5 };
